<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_widget_card"
    android:padding="12dp">

    <!-- Header: Title + Streak Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🧠 AttentionAI"
            android:textColor="@color/primary_taupe_deep"
            android:textStyle="bold"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvWidgetUserId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" • user_01"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Streak Badge -->
        <TextView
            android:id="@+id/tvWidgetStreak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔥 3 Days"
            android:textColor="@color/status_distracted"
            android:textStyle="bold"
            android:textSize="11sp"
            android:background="@drawable/bg_badge_distracted"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp" />
    </LinearLayout>

    <!-- Metrics Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginVertical="6dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TODAY'S STUDY"
                android:textColor="@color/text_muted"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvWidgetTodayTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="109m"
                android:textColor="@color/primary_taupe"
                android:textStyle="bold"
                android:textSize="17sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AVG / SESSION"
                android:textColor="@color/text_muted"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvWidgetAvgSession"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="26m"
                android:textColor="@color/primary_taupe_deep"
                android:textStyle="bold"
                android:textSize="17sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TOTAL SESSIONS"
                android:textColor="@color/text_muted"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvWidgetTotalSessions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="14"
                android:textColor="@color/status_focused"
                android:textStyle="bold"
                android:textSize="17sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Quick Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnWidgetStart"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="▶ Start Session"
            android:textColor="@color/text_on_taupe"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/bg_button_restore"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnWidgetStats"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="📊 View Stats"
            android:textColor="@color/primary_taupe_deep"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/bg_button_secondary"
            android:layout_marginStart="4dp" />
    </LinearLayout>

</LinearLayout>
