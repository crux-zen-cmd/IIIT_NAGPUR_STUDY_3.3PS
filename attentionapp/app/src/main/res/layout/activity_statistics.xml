<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/statMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0B101B">

    <!-- Top Navigation & User ID Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:background="#111827"
        android:paddingHorizontal="12dp"
        android:elevation="4dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@android:drawable/ic_menu_revert"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="#F8FAFC"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📊 Study Analytics &amp; Insights"
            android:textColor="#F8FAFC"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginStart="8dp" />

        <!-- User ID Badge / Switcher -->
        <LinearLayout
            android:id="@+id/btnSwitchUser"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#1E293B"
            android:paddingHorizontal="10dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tvStatUserId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👤 user_01"
                android:textColor="#A78BFA"
                android:textStyle="bold"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" ▾"
                android:textColor="#94A3B8"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Executive Summary Cards -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <!-- Today Total Time Card -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="#111827"
                    android:padding="12dp"
                    android:layout_marginEnd="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⏱️ TODAY'S STUDY"
                        android:textColor="#94A3B8"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvTotalStudyToday"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0m"
                        android:textColor="#38BDF8"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:id="@+id/tvTodaySessionsCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 sessions"
                        android:textColor="#64748B"
                        android:textSize="11sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <!-- Coins Card -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="#111827"
                    android:padding="12dp"
                    android:layout_marginHorizontal="2dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🪙 COIN BALANCE"
                        android:textColor="#F59E0B"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvStatTotalCoins"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.00"
                        android:textColor="#FBBF24"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:id="@+id/tvStatTodayCoins"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+0.00 today"
                        android:textColor="#10B981"
                        android:textSize="11sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <!-- Best Study Window Card -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.1"
                    android:orientation="vertical"
                    android:background="#111827"
                    android:padding="12dp"
                    android:layout_marginStart="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🌟 PEAK FOCUS"
                        android:textColor="#A78BFA"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvBestStudyTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Evening (88%)"
                        android:textColor="#F8FAFC"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Real session focus"
                        android:textColor="#64748B"
                        android:textSize="10sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- LeetCode / GitHub Streak Activity Heatmap Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#111827"
                android:padding="14dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🔥 STUDY ACTIVITY &amp; STREAK"
                        android:textColor="#E2E8F0"
                        android:textStyle="bold"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvHeatmapStreakBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔥 0 Day Streak"
                        android:textColor="#10B981"
                        android:textStyle="bold"
                        android:textSize="11sp"
                        android:background="#064E3B"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp" />
                </LinearLayout>

                <!-- Streak & Active Days Summary Bar -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="#1E293B"
                    android:padding="10dp"
                    android:gravity="center"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvStatCurrentStreak"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 Days"
                            android:textColor="#38BDF8"
                            android:textStyle="bold"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Current Streak"
                            android:textColor="#94A3B8"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="24dp"
                        android:background="#334155" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvStatMaxStreak"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 Days"
                            android:textColor="#F59E0B"
                            android:textStyle="bold"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Longest Streak"
                            android:textColor="#94A3B8"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="24dp"
                        android:background="#334155" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvStatActiveDays"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 Days"
                            android:textColor="#10B981"
                            android:textStyle="bold"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Active Days"
                            android:textColor="#94A3B8"
                            android:textSize="10sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Horizontal Scrollable LeetCode/GitHub Heatmap Grid -->
                <HorizontalScrollView
                    android:id="@+id/scrollHeatmap"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:fillViewport="true">

                    <com.example.attentionapp.StreakHeatmapView
                        android:id="@+id/viewStreakHeatmap"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </HorizontalScrollView>

                <!-- Interactive Day Details Banner -->
                <TextView
                    android:id="@+id/tvHeatmapDayDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#1E293B"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp"
                    android:text="👉 Tap any day above to view exact study duration"
                    android:textColor="#F8FAFC"
                    android:textSize="11sp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="8dp" />

                <!-- Heatmap Legend -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical|end">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Less"
                        android:textColor="#64748B"
                        android:textSize="10sp"
                        android:layout_marginEnd="6dp" />

                    <View
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="#1E293B"
                        android:layout_marginEnd="3dp" />

                    <View
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="#86EFAC"
                        android:layout_marginEnd="3dp" />

                    <View
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="#34D399"
                        android:layout_marginEnd="3dp" />

                    <View
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="#10B981"
                        android:layout_marginEnd="3dp" />

                    <View
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="#047857"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="More"
                        android:textColor="#64748B"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Chart 1: FOCUS SCORE OVER TIME (Image 1) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#111827"
                android:padding="14dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📈 FOCUS SCORE OVER TIME"
                    android:textColor="#E2E8F0"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:layout_marginBottom="8dp" />

                <com.example.attentionapp.FocusScoreLineChartView
                    android:id="@+id/chartScoreTimeline"
                    android:layout_width="match_parent"
                    android:layout_height="170dp" />
            </LinearLayout>

            <!-- Chart 2: STUDY DURATION BY DAY (Image 2) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#111827"
                android:padding="14dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📅 STUDY DURATION BY DAY"
                    android:textColor="#E2E8F0"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:layout_marginBottom="8dp" />

                <com.example.attentionapp.StudyDurationBarChartView
                    android:id="@+id/chartDurationByDay"
                    android:layout_width="match_parent"
                    android:layout_height="170dp" />
            </LinearLayout>

            <!-- Chart 3: FOCUS BY TIME OF DAY (Image 3) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#111827"
                android:padding="14dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⏰ FOCUS BY TIME OF DAY"
                    android:textColor="#E2E8F0"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:layout_marginBottom="8dp" />

                <com.example.attentionapp.FocusByTimeBarChartView
                    android:id="@+id/chartFocusByTime"
                    android:layout_width="match_parent"
                    android:layout_height="170dp" />
            </LinearLayout>

            <!-- Table / List: COMPLETED STUDY SESSIONS (Image 4) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#111827"
                android:padding="14dp"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📜 COMPLETED STUDY SESSIONS"
                    android:textColor="#E2E8F0"
                    android:textStyle="bold"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Detailed focus metrics, tab distractions, &amp; timelines"
                    android:textColor="#64748B"
                    android:textSize="11sp"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:id="@+id/tvEmptyHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="No completed study sessions yet for this user.\nStart a study session to generate real analytics!"
                    android:textColor="#64748B"
                    android:textSize="12sp"
                    android:padding="20dp"
                    android:visibility="visible" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvSessionHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
