<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_session_history_card"
    android:padding="14dp"
    android:layout_marginBottom="10dp"
    android:elevation="1dp">

    <!-- Top Row: Course/Topic + Coins Badge + Focus Score Pill -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvSessionCourse"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Machine Learning"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/tvSessionPlatform"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Study Portal"
                    android:textColor="@color/accent_violet"
                    android:textSize="10sp"
                    android:background="@drawable/bg_badge_focused"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp" />

                <TextView
                    android:id="@+id/tvSessionDateTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Oct 26 · 03:15 AM"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp"
                    android:layout_marginStart="8dp" />

                <!-- Time of Day Tag (Morning, Evening, etc.) -->
                <TextView
                    android:id="@+id/tvSessionTimeOfDayTag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Late Night"
                    android:textColor="@color/accent_amber"
                    android:textSize="10sp"
                    android:background="@drawable/bg_badge_distracted"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:layout_marginStart="6dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Coins Badge -->
        <TextView
            android:id="@+id/tvSessionCoins"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+0.50 🪙"
            android:textColor="@color/accent_amber"
            android:textStyle="bold"
            android:textSize="11sp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:background="@drawable/bg_badge_coins"
            android:layout_marginEnd="6dp" />

        <!-- Focus Score Pill Badge -->
        <TextView
            android:id="@+id/tvSessionFocusScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="93%"
            android:textColor="@color/accent_lime"
            android:textStyle="bold"
            android:textSize="13sp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:background="@drawable/bg_badge_focused" />
    </LinearLayout>

    <!-- Middle Row: Metrics Grid -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp">

        <TextView
            android:id="@+id/tvSessionDuration"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⏱️ 24m 15s"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvSessionDistraction"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⚡ 2 tabs switched"
            android:textColor="@color/status_distracted"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvSessionNotifs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔔 3 Notifs (2 Ignored)"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Bottom Row: Color Breakdown Bar -->
    <LinearLayout
        android:id="@+id/layoutBreakdownBar"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:background="@color/border_primary">

        <View
            android:id="@+id/viewBarFocused"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="80"
            android:background="@color/status_focused" />

        <View
            android:id="@+id/viewBarDistracted"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="15"
            android:background="@color/status_distracted" />

        <View
            android:id="@+id/viewBarLost"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="5"
            android:background="@color/status_lost" />
    </LinearLayout>

</LinearLayout>
